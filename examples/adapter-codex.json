{
  "id": "codex",
  "displayName": "Codex CLI",
  "version": "0.1.0",
  "executables": [
    "codex",
    "codex.exe"
  ],
  "platforms": [
    "win32",
    "darwin",
    "linux"
  ],
  "capabilities": {
    "interactive": true,
    "nonInteractive": true,
    "resume": true,
    "structuredOutput": true,
    "mcp": true,
    "imageInput": true
  },
  "permissions": [
    "filesystem",
    "process",
    "network-by-provider"
  ]
}
