{
  "name": "forgedeck",
  "version": "0.2.0-beta.1",
  "private": true,
  "description": "Local-first desktop orchestration for coding agents",
  "license": "AGPL-3.0-only",
  "author": "Gabriel Machado",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabriel-r-machado/compazio.git"
  },
  "bugs": {
    "url": "https://github.com/gabriel-r-machado/compazio/issues"
  },
  "homepage": "https://github.com/gabriel-r-machado/compazio#readme",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "brand:icons": "node scripts/brand/build-windows-icon.mjs",
    "build": "turbo run build",
    "release:windows:beta": "node scripts/release/windows-beta.mjs",
    "release:windows:github": "tsx scripts/release/publish-github.ts",
    "release:windows:upload": "pnpm release:windows:github",
    "dev": "turbo run dev --parallel",
    "dev:desktop": "pnpm --filter @forgedeck/desktop dev",
    "dev:desktop:v2": "pnpm --filter @forgedeck/desktop dev:v2",
    "dev:web": "pnpm --filter @forgedeck/web dev",
    "compasso": "pnpm --filter @forgedeck/cli compasso",
    "format": "prettier --write apps packages specs/schemas .github package.json pnpm-workspace.yaml turbo.json tsconfig.base.json tsconfig.package.json eslint.config.mjs vitest.config.ts vitest.integration.config.ts docs/19-development.md docs/20-local-runtime.md docs/21-canvas-workflows.md docs/22-git-quality.md START_HERE.md",
    "format:check": "prettier --check apps packages specs/schemas .github package.json pnpm-workspace.yaml turbo.json tsconfig.base.json tsconfig.package.json eslint.config.mjs vitest.config.ts vitest.integration.config.ts docs/19-development.md docs/20-local-runtime.md docs/21-canvas-workflows.md docs/22-git-quality.md START_HERE.md",
    "lint": "eslint . --max-warnings 0 && pnpm format:check",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:desktop-smoke": "pnpm --filter @forgedeck/desktop smoke",
    "test:v2-electron-smoke": "pnpm --filter @forgedeck/desktop smoke:v2",
    "test:portal-integration": "pnpm --filter @forgedeck/desktop test:portal-integration",
    "test:portal-electron-smoke": "pnpm --filter @forgedeck/desktop smoke:portals",
    "typecheck:portal-real-agents": "pnpm --filter @forgedeck/desktop typecheck:portal-real-agents",
    "test:portal-agent-harness": "pnpm --filter @forgedeck/desktop test:portal-agent-harness",
    "test:portal-real-agents": "pnpm --filter @forgedeck/desktop test:portal-real-agents",
    "test:portal-real-agent": "pnpm --filter @forgedeck/desktop test:portal-real-agent",
    "test:portal-mcp-real-agents": "pnpm --filter @forgedeck/desktop test:portal-mcp-real-agents",
    "test:adapter:codex-local": "pnpm --filter @forgedeck/desktop test:adapter:codex-local",
    "test:adapter:opencode-local": "pnpm --filter @forgedeck/desktop test:adapter:opencode-local",
    "test:multi-agent:e2e-local": "pnpm --filter @forgedeck/desktop test:multi-agent:e2e-local",
    "test:orchestrator:codex-local": "pnpm --filter @forgedeck/desktop test:orchestrator:codex-local",
    "test:orchestrator:opencode-local": "pnpm --filter @forgedeck/desktop test:orchestrator:opencode-local",
    "test:automatic:claude-local": "pnpm --filter @forgedeck/desktop test:automatic-claude-local",
    "test:automatic:e2e-local": "pnpm --filter @forgedeck/desktop test:automatic-e2e-local",
    "test:electron-smoke": "pnpm --filter @forgedeck/desktop test:electron-smoke",
    "test:e2e": "pnpm --filter @forgedeck/desktop test:e2e",
    "test:beta-e2e": "node apps/desktop/scripts/beta-e2e.mjs",
    "test:beta-e2e-real": "node apps/desktop/scripts/beta-e2e-real.mjs",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @forgedeck/local-db db:generate",
    "db:migrate": "pnpm --filter @forgedeck/local-db db:migrate",
    "license:issue:beta": "tsx scripts/licensing/license-admin.ts issue",
    "license:list": "tsx scripts/licensing/license-admin.ts list",
    "license:revoke": "tsx scripts/licensing/license-admin.ts revoke",
    "license:deactivate": "tsx scripts/licensing/license-admin.ts deactivate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "sharp": "0.34.5",
    "supabase": "2.109.1",
    "tsx": "4.23.1",
    "turbo": "2.10.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  }
}
