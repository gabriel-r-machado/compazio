# Public values may be embedded by the desktop build. Never put service_role or private signing keys here.
COMPAZIO_SUPABASE_URL=https://<project-ref>.supabase.co
COMPAZIO_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<public-key>
COMPAZIO_LICENSE_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n<base64-public-key>\n-----END PUBLIC KEY-----
# The GitHub Releases update feed is embedded by electron-builder at package time.
# No runtime update-base URL is accepted.
COMPAZIO_UPDATE_CHANNEL=beta

# Local/CI administration only (never shipped in the app).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<local-only-service-role>
LICENSE_CODE_PEPPER=<local-only-random-secret>
LICENSE_SIGNING_PRIVATE_KEY=<local-only-base64-pkcs8-ed25519>
LICENSE_SIGNING_PUBLIC_KEY=<edge-only-base64-spki-ed25519>
LICENSE_SIGNING_KEY_ID=<public-key-id>
