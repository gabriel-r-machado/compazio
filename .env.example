# Shared
NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info

# Desktop
DESKTOP_ENABLE_DEVTOOLS=true
DESKTOP_MAX_TERMINAL_BUFFER_LINES=10000
DESKTOP_MAX_PARALLEL_RUNS=4
DESKTOP_ALLOW_REMOTE_CONTROL=false
DESKTOP_CLOUD_SYNC=false
# Server endpoint used by the desktop only after explicit cloud opt-in. HTTPS is
# required outside localhost and the renderer cannot change this endpoint.
FORGEDECK_CLOUD_SYNC_API_URL=

# Web / Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback only. Prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY for new projects.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Never place this in a NEXT_PUBLIC_ variable or the desktop app.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Feature flags
NEXT_PUBLIC_CLOUD_ENABLED=false
NEXT_PUBLIC_BILLING_ENABLED=false
NEXT_PUBLIC_TELEMETRY_ENABLED=false

# AbacatePay — somente quando billing estiver habilitado
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
ABACATEPAY_WEBHOOK_PUBLIC_KEY=
ABACATEPAY_API_BASE_URL=https://api.abacatepay.com/v2
ABACATEPAY_PRODUCT_PRO_ID=
ABACATEPAY_PRODUCT_TEAM_ID=
BILLING_GRACE_PERIOD_DAYS=3
# Required only for the server-side reconciliation endpoint; never expose it to a browser or desktop app.
BILLING_RECONCILIATION_SECRET=

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
DESKTOP_DEEP_LINK_SCHEME=forgedeck
