{
  "$schema": "https://json.schemastore.org/electron-builder",
  "appId": "com.compazio.community",
  "productName": "Compazio Community",
  "publish": [
    {
      "provider": "github",
      "owner": "gabriel-r-machado",
      "repo": "compazio",
      "channel": "beta",
      "releaseType": "prerelease"
    }
  ],
  "generateUpdatesFilesForAllChannels": true,
  "detectUpdateChannel": true,
  "extraMetadata": {
    "main": "./out-v2/main/index.js"
  },
  "artifactName": "Compazio-Setup-${version}.${ext}",
  "copyright": "Copyright © 2026 Compazio",
  "directories": {
    "buildResources": "build",
    "output": "release"
  },
  "files": [
    "out-v2/**/*",
    "package.json",
    "!**/*.map",
    "!**/*.ts",
    "!**/*.test.*",
    "!**/e2e/**",
    "!**/scripts/**",
    "!**/.env*",
    "!**/.claude/**",
    "!**/.codex/**",
    "!**/coverage/**",
    "!**/release/**"
  ],
  "asar": true,
  "npmRebuild": false,
  "asarUnpack": ["**/node_modules/better-sqlite3/**", "**/node_modules/node-pty/**"],
  "extraResources": [
    {
      "from": "../../packages/local-db/drizzle",
      "to": "drizzle"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "executableName": "Compazio",
    "icon": "build/icon.ico",
    "requestedExecutionLevel": "asInvoker",
    "signAndEditExecutable": true
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Compazio Community",
    "runAfterFinish": false
  }
}
