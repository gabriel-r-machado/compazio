# Optional web app configuration.
# Compazio Community desktop does not require this file.
# Copy to apps/web/.env.local only when developing the web app.

# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback only; prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase values. Never expose these through NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Optional features
NEXT_PUBLIC_CLOUD_ENABLED=false
NEXT_PUBLIC_BILLING_ENABLED=false
NEXT_PUBLIC_TELEMETRY_ENABLED=false

# Billing — used only when billing is explicitly enabled
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
ABACATEPAY_WEBHOOK_PUBLIC_KEY=
ABACATEPAY_API_BASE_URL=https://api.abacatepay.com/v2
ABACATEPAY_PRODUCT_PRO_ID=
ABACATEPAY_PRODUCT_TEAM_ID=
BILLING_GRACE_PERIOD_DAYS=3
# Server-side reconciliation only; never expose this value to a browser or desktop app.
BILLING_RECONCILIATION_SECRET=

# Web app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
