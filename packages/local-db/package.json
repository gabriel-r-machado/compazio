{
  "name": "@forgedeck/local-db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate-cli.ts"
  },
  "dependencies": {
    "@forgedeck/logger": "workspace:*",
    "@forgedeck/git": "workspace:*",
    "@forgedeck/orchestration": "workspace:*",
    "@forgedeck/schemas": "workspace:*",
    "@forgedeck/terminal": "workspace:*",
    "@forgedeck/workflow": "workspace:*",
    "better-sqlite3": "12.11.1",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.20.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15"
  }
}
