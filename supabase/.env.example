# Optional Supabase / compatibility-function configuration.
# These values are NOT required to run the Compazio Community desktop.
# Never commit real service-role keys, peppers or signing keys.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<local-only-service-role>

# Legacy entitlement compatibility functions
LICENSE_ALLOWED_ORIGIN=http://localhost:3000
LICENSE_CODE_PEPPER=<local-only-random-secret>
LICENSE_SIGNING_PRIVATE_KEY=<local-only-base64-pkcs8-ed25519>
LICENSE_SIGNING_PUBLIC_KEY=<local-only-base64-spki-ed25519>
LICENSE_SIGNING_KEY_ID=beta
